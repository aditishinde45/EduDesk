PORT=5050

# Database Configuration
# Option A: MySQL (Default)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/edudesk_db

# Option B: PostgreSQL (for pgAdmin)
# DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/edudesk_db

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
